# PostgreSQL. Use URL-safe random values because the password is embedded in a URL.
POSTGRES_DB=karuni
POSTGRES_USER=karuni
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# Local Docker access. For production, set the public HTTPS origin instead.
KARUNI_BIND=127.0.0.1
KARUNI_PORT=18786
KARUNI_ORIGIN=http://127.0.0.1:18786

# Initial administrator. The password must be at least 16 characters.
KARUNI_ADMIN_EMAIL=admin@example.com
KARUNI_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# 9Router OpenAI-compatible endpoint and dashboard API key.
KARUNI_UPSTREAM_URL=https://9router.com/v1
KARUNI_UPSTREAM_KEY=replace-with-your-9router-api-key

# Set true only for a trusted, private HTTP 9Router endpoint such as
# http://host.docker.internal:20128/v1. Never use this over the public internet.
KARUNI_ALLOW_INSECURE_UPSTREAM=false

# Optional secondary 9Router key and exact upstream model IDs routed through it.
KARUNI_UNCENSORED_KEY=
KARUNI_UNCENSORED_MODELS=[]

# Customer and referral settings.
KARUNI_REGISTRATION=open
KARUNI_REFERRAL_ENABLED=true
KARUNI_REFERRAL_RATE_BPS=1000
KARUNI_IDR_PER_CREDIT=1

# Optional Google Identity Services Web client ID. No client secret is used.
KARUNI_GOOGLE_CLIENT_ID=

# Production-only Caddy hostname, without scheme or path.
KARUNI_DOMAIN=ai.example.com
